{
  "$defs": {
    "AbsencePattern": {
      "additionalProperties": false,
      "description": "Fire once when nothing has passed the filter for ``within`` since the last envelope did.\n\nOnly scopes that have been seen can go quiet. Time passes with every envelope in the log,\nwhether or not it passes the filter.",
      "properties": {
        "kind": {
          "const": "absence",
          "default": "absence",
          "title": "Kind",
          "type": "string"
        },
        "within": {
          "format": "duration",
          "title": "Within",
          "type": "string"
        }
      },
      "required": [
        "within"
      ],
      "title": "AbsencePattern",
      "type": "object"
    },
    "ActionRef": {
      "additionalProperties": false,
      "description": "The action a rule runs, by name, and the params the rule passes it.",
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action"
      ],
      "title": "ActionRef",
      "type": "object"
    },
    "AgentActor": {
      "description": "An agent or graph running an action for one firing of a rule.",
      "properties": {
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/RuleName"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "rule",
        "run_id",
        "name"
      ],
      "title": "AgentActor",
      "type": "object"
    },
    "AllFilter": {
      "additionalProperties": false,
      "description": "Envelopes that match every filter in ``of``.",
      "properties": {
        "kind": {
          "const": "all",
          "default": "all",
          "title": "Kind",
          "type": "string"
        },
        "of": {
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "minItems": 1,
          "title": "Of",
          "type": "array"
        }
      },
      "required": [
        "of"
      ],
      "title": "AllFilter",
      "type": "object"
    },
    "AnyFilter": {
      "additionalProperties": false,
      "description": "Envelopes that match at least one filter in ``of``.",
      "properties": {
        "kind": {
          "const": "any",
          "default": "any",
          "title": "Kind",
          "type": "string"
        },
        "of": {
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "minItems": 1,
          "title": "Of",
          "type": "array"
        }
      },
      "required": [
        "of"
      ],
      "title": "AnyFilter",
      "type": "object"
    },
    "ArchiveRule": {
      "additionalProperties": false,
      "description": "Archive a stored rule, and cancel its unfinished runs.",
      "properties": {
        "expected_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Version"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "rule": {
          "$ref": "#/$defs/RuleName"
        },
        "type": {
          "const": "archive_rule",
          "default": "archive_rule",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "rule"
      ],
      "title": "ArchiveRule",
      "type": "object"
    },
    "CancelRun": {
      "additionalProperties": false,
      "description": "Cancel a run that has not finished, stopping its action if it is running.",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "type": {
          "const": "cancel_run",
          "default": "cancel_run",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "CancelRun",
      "type": "object"
    },
    "Causation": {
      "description": "What caused an event that a run emitted, and how deep its causal chain is.",
      "properties": {
        "depth": {
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "firing_id": {
          "$ref": "#/$defs/FiringId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "firing_id",
        "run_id",
        "depth"
      ],
      "title": "Causation",
      "type": "object"
    },
    "ChainTarget": {
      "additionalProperties": false,
      "description": "Feedback on a causal chain: everything one triggering event led to.",
      "properties": {
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "kind": {
          "const": "chain",
          "default": "chain",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "correlation_id"
      ],
      "title": "ChainTarget",
      "type": "object"
    },
    "ClientFrame": {
      "discriminator": {
        "mapping": {
          "command": "#/$defs/CommandFrame",
          "hello": "#/$defs/Hello"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Hello"
        },
        {
          "$ref": "#/$defs/CommandFrame"
        }
      ]
    },
    "Command": {
      "discriminator": {
        "mapping": {
          "archive_rule": "#/$defs/ArchiveRule",
          "cancel_run": "#/$defs/CancelRun",
          "give_feedback": "#/$defs/GiveFeedback",
          "install_rule": "#/$defs/InstallRule",
          "publish": "#/$defs/Publish",
          "replay_rule": "#/$defs/ReplayRule",
          "retry_run": "#/$defs/RetryRun",
          "skip_run": "#/$defs/SkipRun",
          "update_rule": "#/$defs/UpdateRule"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Publish"
        },
        {
          "$ref": "#/$defs/GiveFeedback"
        },
        {
          "$ref": "#/$defs/RetryRun"
        },
        {
          "$ref": "#/$defs/SkipRun"
        },
        {
          "$ref": "#/$defs/CancelRun"
        },
        {
          "$ref": "#/$defs/ReplayRule"
        },
        {
          "$ref": "#/$defs/InstallRule"
        },
        {
          "$ref": "#/$defs/UpdateRule"
        },
        {
          "$ref": "#/$defs/ArchiveRule"
        }
      ]
    },
    "CommandFrame": {
      "additionalProperties": false,
      "description": "A client's command, with an id that correlates it with its result.\n\n``command_id`` is also an idempotency key: the server deduplicates repeated ids.",
      "properties": {
        "command": {
          "$ref": "#/$defs/Command"
        },
        "command_id": {
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "type": {
          "const": "command",
          "default": "command",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "command"
      ],
      "title": "CommandFrame",
      "type": "object"
    },
    "CommandResult": {
      "additionalProperties": false,
      "description": "The result of one command frame.",
      "properties": {
        "command_id": {
          "title": "Command Id",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rejection": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection"
        },
        "type": {
          "const": "command_result",
          "default": "command_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "ok"
      ],
      "title": "CommandResult",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "A rule's ``when``: a filter, and optionally dedupe, a pattern and a throttle.",
      "properties": {
        "dedupe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dedupe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        },
        "pattern": {
          "$ref": "#/$defs/Pattern",
          "default": {
            "kind": "each"
          }
        },
        "throttle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Throttle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "filter"
      ],
      "title": "Condition",
      "type": "object"
    },
    "CountPattern": {
      "additionalProperties": false,
      "description": "Fire when ``at_least`` envelopes pass within ``within``. A firing consumes them.",
      "properties": {
        "at_least": {
          "minimum": 1,
          "title": "At Least",
          "type": "integer"
        },
        "kind": {
          "const": "count",
          "default": "count",
          "title": "Kind",
          "type": "string"
        },
        "within": {
          "format": "duration",
          "title": "Within",
          "type": "string"
        }
      },
      "required": [
        "at_least",
        "within"
      ],
      "title": "CountPattern",
      "type": "object"
    },
    "Dedupe": {
      "additionalProperties": false,
      "description": "Drop an envelope whose ``key`` fields were already seen within ``within``.",
      "properties": {
        "key": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Key",
          "type": "array"
        },
        "within": {
          "format": "duration",
          "title": "Within",
          "type": "string"
        }
      },
      "required": [
        "key",
        "within"
      ],
      "title": "Dedupe",
      "type": "object"
    },
    "EachPattern": {
      "additionalProperties": false,
      "description": "Fire for every envelope that passes the filter.",
      "properties": {
        "kind": {
          "const": "each",
          "default": "each",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "EachPattern",
      "type": "object"
    },
    "ErrorFrame": {
      "additionalProperties": false,
      "description": "A frame the server could not understand.",
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "ErrorFrame",
      "type": "object"
    },
    "EvaluatorActor": {
      "description": "An evaluator: a judge or decision model whose verdicts are recorded as feedback.",
      "properties": {
        "kind": {
          "const": "evaluator",
          "default": "evaluator",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "EvaluatorActor",
      "type": "object"
    },
    "EventFrame": {
      "description": "An envelope from the log.",
      "properties": {
        "actor": {
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentActor",
              "evaluator": "#/$defs/EvaluatorActor",
              "external_agent": "#/$defs/ExternalAgentActor",
              "source": "#/$defs/SourceActor",
              "system": "#/$defs/SystemActor",
              "user": "#/$defs/UserActor"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UserActor"
            },
            {
              "$ref": "#/$defs/AgentActor"
            },
            {
              "$ref": "#/$defs/ExternalAgentActor"
            },
            {
              "$ref": "#/$defs/SystemActor"
            },
            {
              "$ref": "#/$defs/SourceActor"
            },
            {
              "$ref": "#/$defs/EvaluatorActor"
            }
          ],
          "title": "Actor"
        },
        "causation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Causation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "event": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "Event",
          "type": "object"
        },
        "id": {
          "$ref": "#/$defs/EventId"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "event",
          "default": "event",
          "title": "Type",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "seq",
        "id",
        "ts",
        "workspace_id",
        "actor",
        "correlation_id",
        "event"
      ],
      "title": "EventFrame",
      "type": "object"
    },
    "EventId": {
      "type": "string"
    },
    "ExternalAgentActor": {
      "description": "An agent outside reflexr, connected over MCP.",
      "properties": {
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "kind": {
          "const": "external_agent",
          "default": "external_agent",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "client_id"
      ],
      "title": "ExternalAgentActor",
      "type": "object"
    },
    "FeedbackTarget": {
      "discriminator": {
        "mapping": {
          "chain": "#/$defs/ChainTarget",
          "firing": "#/$defs/FiringTarget",
          "run": "#/$defs/RunTarget"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RunTarget"
        },
        {
          "$ref": "#/$defs/FiringTarget"
        },
        {
          "$ref": "#/$defs/ChainTarget"
        }
      ]
    },
    "Filter": {
      "discriminator": {
        "mapping": {
          "all": "#/$defs/AllFilter",
          "any": "#/$defs/AnyFilter",
          "not": "#/$defs/NotFilter",
          "on": "#/$defs/OnFilter",
          "predicate": "#/$defs/PredicateFilter",
          "where": "#/$defs/WhereFilter"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/OnFilter"
        },
        {
          "$ref": "#/$defs/WhereFilter"
        },
        {
          "$ref": "#/$defs/AllFilter"
        },
        {
          "$ref": "#/$defs/AnyFilter"
        },
        {
          "$ref": "#/$defs/NotFilter"
        },
        {
          "$ref": "#/$defs/PredicateFilter"
        }
      ]
    },
    "FiringId": {
      "type": "string"
    },
    "FiringTarget": {
      "additionalProperties": false,
      "description": "Feedback on one firing: whether the rule should have fired.",
      "properties": {
        "firing_id": {
          "$ref": "#/$defs/FiringId"
        },
        "kind": {
          "const": "firing",
          "default": "firing",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "firing_id"
      ],
      "title": "FiringTarget",
      "type": "object"
    },
    "GiveFeedback": {
      "additionalProperties": false,
      "description": "Give typed feedback on a run, a firing or a causal chain.",
      "properties": {
        "feedback_type": {
          "title": "Feedback Type",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/FeedbackTarget"
        },
        "type": {
          "const": "give_feedback",
          "default": "give_feedback",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Value",
          "type": "object"
        }
      },
      "required": [
        "feedback_type",
        "target",
        "value"
      ],
      "title": "GiveFeedback",
      "type": "object"
    },
    "Hello": {
      "additionalProperties": false,
      "description": "The first frame a client sends on a connection.",
      "properties": {
        "from_head": {
          "default": false,
          "title": "From Head",
          "type": "boolean"
        },
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "resume_after_seq": {
          "default": 0,
          "minimum": 0,
          "title": "Resume After Seq",
          "type": "integer"
        },
        "type": {
          "const": "hello",
          "default": "hello",
          "title": "Type",
          "type": "string"
        },
        "types": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Types"
        }
      },
      "required": [
        "protocol"
      ],
      "title": "Hello",
      "type": "object"
    },
    "InstallRule": {
      "additionalProperties": false,
      "description": "Install a stored rule: its first version, or the next version of an archived one.",
      "properties": {
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "default": {},
          "title": "Provenance",
          "type": "object"
        },
        "rule": {
          "$ref": "#/$defs/Rule"
        },
        "type": {
          "const": "install_rule",
          "default": "install_rule",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "rule"
      ],
      "title": "InstallRule",
      "type": "object"
    },
    "JsonValue": {},
    "NotFilter": {
      "additionalProperties": false,
      "description": "Envelopes that do not match ``filter``.",
      "properties": {
        "filter": {
          "$ref": "#/$defs/Filter"
        },
        "kind": {
          "const": "not",
          "default": "not",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "filter"
      ],
      "title": "NotFilter",
      "type": "object"
    },
    "OnFilter": {
      "additionalProperties": false,
      "description": "Envelopes whose event is one of ``types``.",
      "properties": {
        "kind": {
          "const": "on",
          "default": "on",
          "title": "Kind",
          "type": "string"
        },
        "types": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Types",
          "type": "array"
        }
      },
      "required": [
        "types"
      ],
      "title": "OnFilter",
      "type": "object"
    },
    "Outcome": {
      "discriminator": {
        "mapping": {
          "published": "#/$defs/PublishedOutcome",
          "recorded": "#/$defs/RecordedOutcome",
          "rule": "#/$defs/RuleOutcome",
          "rule_version": "#/$defs/RuleVersionOutcome",
          "run": "#/$defs/RunOutcome"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PublishedOutcome"
        },
        {
          "$ref": "#/$defs/RecordedOutcome"
        },
        {
          "$ref": "#/$defs/RunOutcome"
        },
        {
          "$ref": "#/$defs/RuleOutcome"
        },
        {
          "$ref": "#/$defs/RuleVersionOutcome"
        }
      ]
    },
    "Pattern": {
      "discriminator": {
        "mapping": {
          "absence": "#/$defs/AbsencePattern",
          "count": "#/$defs/CountPattern",
          "each": "#/$defs/EachPattern",
          "sequence": "#/$defs/SequencePattern"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/EachPattern"
        },
        {
          "$ref": "#/$defs/CountPattern"
        },
        {
          "$ref": "#/$defs/SequencePattern"
        },
        {
          "$ref": "#/$defs/AbsencePattern"
        }
      ]
    },
    "PredicateFilter": {
      "additionalProperties": false,
      "description": "Envelopes whose event the registered Python predicate ``name`` accepts.\n\nAn escape hatch for what the other filters cannot express. Predicates must be pure.",
      "properties": {
        "kind": {
          "const": "predicate",
          "default": "predicate",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "PredicateFilter",
      "type": "object"
    },
    "Publish": {
      "additionalProperties": false,
      "description": "Publish an event. Publishing an ``id`` already in the log appends nothing.",
      "properties": {
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
