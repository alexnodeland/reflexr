{
  "name": "reflexr",
  // Built on the contributor Compose file (ADR-0021): PostgreSQL runs beside the dev container,
  // and when stackr's stack is running, the dev container joins its network (ADR-0037).
  "dockerComposeFile": ["../compose.yaml", "compose.yaml", "stackr.generated.yaml"],
  "service": "dev",
  "runServices": ["postgres", "dev"],
  "workspaceFolder": "/workspaces/reflexr",
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "features": {
    "github-cli": "latest",
    "ghcr.io/va-h/devcontainers-features/uv:1": {},
    "ghcr.io/devcontainers/features/node:1": {}
  },
  // oncall, when you run it in the container.
  "forwardPorts": [8000],
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.unusedImports": "explicit"
          }
        },
        "python.defaultInterpreterPath": ".venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        // Forward SSH agent
        "remote.containers.forwardAgent": true
      },
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "charliermarsh.ruff",
        "wayou.vscode-todo-highlight",
        "timonwong.shellcheck",
        "ms-python.python",
        "esbenp.prettier-vscode",
        "tamasfe.even-better-toml",
        "ms-vsliveshare.vsliveshare",
        "donjayamanne.githistory",
        "mechatroner.rainbow-csv",
        "GrapeCity.gc-excelviewer",
        "Gruntfuggly.todo-tree",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid"
      ]
    }
  },
  "remoteUser": "vscode"
}
