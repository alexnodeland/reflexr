{
  "description": "Patterns: when the envelopes a rule considers make it fire.",
  "cases": [
    {
      "name": "count fires when enough arrive within the window, and consumes them",
      "rule": {
        "when": {
          "filter": {
            "kind": "on",
            "types": [
              "app:service.error"
            ]
          },
          "pattern": {
            "kind": "count",
            "at_least": 3,
            "within": "PT60S"
          }
        }
      },
      "envelopes": [
        {
          "seq": 1,
          "at": 0,
          "event": {
            "type": "app:service.error",
            "service": "auth"
          }
        },
        {
          "seq": 2,
          "at": 10,
          "event": {
            "type": "app:service.error",
            "service": "auth"
          }
        },
        {
          "seq": 3,
          "at": 20,
          "event": {
            "type": "app:service.error",
            "service": "auth"
          }
        },
        {
          "seq": 4,
          "at": 30,
          "event": {
            "type": "app:service.error",
            "service": "auth"
          }
        },
        {
          "seq": 5,
          "at": 40,
          "event": {
            "type": "app:service.error",
            "service": "auth"
          }
        },
        {
          "seq": 6,
          "at": 50,
          "event": {
            "type": "app:service.error",
            "service": "auth"
          }
        }
      ],
      "expect": {
        "firings": [
          {
            "seq": 3,
            "matched": [
              1,
              2,
              3
            ]
          },
          {
            "seq": 6,
            "matched": [
              4,
              5,
              6
            ]
          }
        ],
        "errors": []
      }
    },
    {
