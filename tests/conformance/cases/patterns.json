      "envelopes": [
        {
          "seq": 1,
          "at": 0,
          "event": {
            "type": "app:service.error",
            "service": "auth"
          }
        },
        {
          "seq": 2,
          "at": 5,
          "event": {
            "type": "app:service.error",
            "service": "auth"
