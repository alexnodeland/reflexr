          }
        ],
        "errors": []
      }
    },
    {
      "name": "a sequence fires when its steps happen in order",
      "rule": {
        "when": {
          "filter": {
            "kind": "any",
            "of": [
              {
                "kind": "on",
                "types": [
                  "app:deploy.finished"
                ]
              },
              {
                "kind": "all",
                "of": [
                  {
                    "kind": "on",
                    "types": [
                      "app:service.error"
                    ]
                  },
                  {
                    "kind": "where",
                    "field": "severity",
                    "op": "ge",
                    "value": 7
                  }
                ]
              }
            ]
          },
          "pattern": {
            "kind": "sequence",
            "steps": [
              {
                "kind": "on",
                "types": [
                  "app:deploy.finished"
                ]
              },
              {
                "kind": "all",
                "of": [
                  {
                    "kind": "on",
                    "types": [
                      "app:service.error"
                    ]
                  },
                  {
                    "kind": "where",
                    "field": "severity",
                    "op": "ge",
                    "value": 7
                  }
                ]
              }
            ],
            "within": "PT600S"
          }
        },
        "scope": {
          "fields": [
            "service"
          ]
        }
      },
      "envelopes": [
        {
          "seq": 1,
          "at": 0,
          "event": {
            "type": "app:deploy.finished",
            "service": "auth"
          }
        },
        {
          "seq": 2,
          "at": 60,
          "event": {
            "type": "app:service.error",
            "service": "auth",
            "severity": 8
          }
        }
      ],
      "expect": {
        "firings": [
          {
            "seq": 2,
            "matched": [
              1,
              2
            ],
            "scope": {
              "service": "auth"
            }
          }
        ],
        "errors": []
      }
    },
