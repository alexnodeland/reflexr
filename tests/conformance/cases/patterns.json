    {
      "name": "absence fires once when a scope goes quiet",
      "rule": {
        "when": {
          "filter": {
            "kind": "on",
            "types": [
              "app:heartbeat"
            ]
          },
          "pattern": {
            "kind": "absence",
            "within": "PT300S"
          }
        },
        "scope": {
          "fields": [
            "service"
          ]
        }
      },
      "envelopes": [
        {
          "seq": 1,
          "at": 0,
          "event": {
            "type": "app:heartbeat",
            "service": "auth"
          }
        },
        {
          "seq": 2,
          "at": 299,
          "event": {
            "type": "reflexr:tick",
            "schedule": "clock",
            "at": "2026-01-01T00:00:00Z"
          }
        },
        {
          "seq": 3,
          "at": 300,
          "event": {
            "type": "reflexr:tick",
            "schedule": "clock",
            "at": "2026-01-01T00:00:00Z"
          }
        },
        {
          "seq": 4,
          "at": 600,
          "event": {
            "type": "reflexr:tick",
            "schedule": "clock",
            "at": "2026-01-01T00:00:00Z"
          }
        }
      ],
      "expect": {
        "firings": [
          {
            "seq": 3,
            "matched": [
              1
            ],
            "scope": {
              "service": "auth"
            }
          }
        ],
        "errors": []
      }
    },
