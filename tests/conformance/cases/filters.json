{
  "description": "Filters: which envelopes a rule considers.",
  "cases": [
    {
      "name": "on fires for every envelope of its type",
      "rule": {
        "when": {
          "filter": {
            "kind": "on",
            "types": [
              "service.error"
            ]
          }
        }
      },
      "envelopes": [
        {
          "seq": 1,
          "at": 0,
          "event": {
            "type": "service.error",
            "service": "auth"
          }
        },
        {
          "seq": 2,
          "at": 1,
          "event": {
            "type": "deploy.finished",
            "service": "auth"
          }
        },
        {
          "seq": 3,
          "at": 2,
          "event": {
            "type": "service.error",
            "service": "billing"
          }
        }
      ],
      "expect": {
        "firings": [
          {
            "seq": 1,
            "matched": [
              1
            ],
            "scope": {}
          },
          {
            "seq": 3,
            "matched": [
              3
            ],
            "scope": {}
          }
        ],
        "errors": []
      }
    },
