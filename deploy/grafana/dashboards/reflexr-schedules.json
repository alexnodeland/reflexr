      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (reflexr_schedule) (rate(reflexr_schedule_ticks_total{job=~\"$job\", deployment_environment_name=~\"$environment\", reflexr_tenant_id=~\"$tenant\"}[$__rate_interval])) > 0)",
          "interval": "1m",
          "datasource": {
