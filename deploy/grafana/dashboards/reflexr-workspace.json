  "panels": [
    {
      "type": "timeseries",
      "title": "Events by type",
      "description": "Events appended per second, by type.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reflexr_event_type) (rate(reflexr_events_published_total{job=~\"$job\", deployment_environment_name=~\"$environment\", reflexr_tenant_id=~\"$tenant\", reflexr_workspace_id=~\"$workspace\", reflexr_event_duplicate=\"false\"}[$__rate_interval]))",
          "legendFormat": "{{reflexr_event_type}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
