        }
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Attempt duration by outcome",
      "description": "The 95th percentile, by how the attempt ended: slow failures are often timeouts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, reflexr_run_status) (rate(reflexr_run_duration_seconds_bucket{job=~\"$job\", deployment_environment_name=~\"$environment\", reflexr_tenant_id=~\"$tenant\"}[$__rate_interval])))",
          "legendFormat": "{{reflexr_run_status}} p95",
          "interval": "1m",
          "exemplar": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Operators",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Operator actions",
      "description": "Runs people and external agents retried (pending), skipped or cancelled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reflexr_run_status, reflexr_actor_kind) (rate(reflexr_runs_total{job=~\"$job\", deployment_environment_name=~\"$environment\", reflexr_tenant_id=~\"$tenant\", reflexr_actor_kind!=\"system\"}[$__rate_interval]))",
          "legendFormat": "{{reflexr_run_status}} by {{reflexr_actor_kind}}",
          "interval": "1m",
          "exemplar": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Attempts by rule",
      "description": "Run attempts started, by rule: first attempts and retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reflexr_rule) (rate(reflexr_run_attempts_total{job=~\"$job\", deployment_environment_name=~\"$environment\", reflexr_tenant_id=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{reflexr_rule}}",
          "interval": "1m",
          "exemplar": false,
