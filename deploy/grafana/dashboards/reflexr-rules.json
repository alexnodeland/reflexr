        "query": {
          "query": "label_values(reflexr_events_published_total{job=~\"$job\", deployment_environment_name=~\"$environment\", reflexr_tenant_id=~\"$tenant\"}, reflexr_workspace_id)",
          "refId": "workspace"
        },
        "definition": "label_values(reflexr_events_published_total{job=~\"$job\", deployment_environment_name=~\"$environment\", reflexr_tenant_id=~\"$tenant\"}, reflexr_workspace_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
