{
  "uid": "reflexr-rules",
  "title": "reflexr / Rules",
  "description": "Rules: how far behind the log they are, how often they fire, and their errors.",
  "tags": [
    "reflexr"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "reflexr dashboards",
      "type": "dashboards",
      "tags": [
        "reflexr"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
