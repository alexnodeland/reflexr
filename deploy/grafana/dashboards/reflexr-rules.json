        {
          "refId": "A",
          "expr": "sum (rate(reflexr_rule_errors_total{job=~\"$job\", deployment_environment_name=~\"$environment\", reflexr_tenant_id=~\"$tenant\", reflexr_workspace_id=~\"$workspace\"}[$__rate_interval]))",
