          "expr": "histogram_quantile(0.95, sum by (le) (rate(reflexr_evaluation_duration_seconds_bucket{job=~\"$job\", deployment_environment_name=~\"$environment\", reflexr_tenant_id=~\"$tenant\", reflexr_workspace_id=~\"$workspace\"}[$__rate_interval])))",
          "legendFormat": "p95",
